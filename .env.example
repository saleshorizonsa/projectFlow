DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
WHATSAPP_VERIFY_TOKEN="choose-a-private-webhook-verify-token"
WHATSAPP_DEFAULT_COMPANY_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
AUTOMATION_SECRET="choose-a-private-automation-token"
# Email alerts: resend | gmail | office365 | smtp
ALERT_EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Optional for gmail/office365 (defaults to SMTP_USER); must be the sending mailbox or an allowed alias
ALERT_FROM_EMAIL="ProjectFlow <alerts@example.com>"
# gmail/office365/smtp: mailbox login. For Gmail use a Google App Password (requires 2-Step Verification)
SMTP_USER=""
SMTP_PASS=""
# smtp only
SMTP_HOST=""
SMTP_PORT="587"
# SIEM integrations (Microsoft 365) — 64 hex chars (32 bytes) for AES-256-GCM secret encryption
ENCRYPTION_KEY=""
# Shared secret protecting /api/cron/o365-sync; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""
